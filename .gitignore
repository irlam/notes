venv/
__pycache__/
*.pyc
.env
*.db
uploads/
*.log
.DS_Store
# Platform-specific compiled extensions – never commit generic .so/.pyd
# files from _pydeps.  Pillow's manylinux wheel extensions are explicitly
# allowed because they ship as a self-contained bundle (pillow.libs/) that
# works on all modern Linux x86-64 hosts without any system libraries.
_pydeps/**/*.pyd
_pydeps/**/*.so
!_pydeps/PIL/*.so
!_pydeps/pillow.libs/*.so
!_pydeps/pillow.libs/*.so.*
