SECRET_KEY=change-me-to-a-random-secret-key
DATABASE_PATH=notes.db
FLASK_ENV=production

# Session / cookie security
# Set to true in production (HTTPS required)
SESSION_COOKIE_SECURE=false
# Session lifetime in days (default: 14)
SESSION_LIFETIME_DAYS=14

# ---------------------------------------------------------------------------
# Milestone 10 — Email PDF + Batch Export
# Set ENABLE_EMAIL_EXPORT=true and configure SMTP_* vars to activate.
# ---------------------------------------------------------------------------
ENABLE_EMAIL_EXPORT=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
